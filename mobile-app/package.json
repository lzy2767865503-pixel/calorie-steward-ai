{
  "name": "calorie-steward-mobile",
  "version": "1.2.3",
  "license": "Apache-2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:web:windows": "expo export --platform web --output-dir ../windows-app/dist-web && node ../windows-app/scripts/prepare-export.cjs",
    "prebuild": "npm run verify:attribution && npm run verify:bilingual && expo prebuild",
    "verify:attribution": "tsx scripts/verify-official-attribution.ts",
    "verify:bilingual": "tsx scripts/verify-bilingual-ui.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "npm run verify:attribution && npm run verify:bilingual && npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.14",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
