{
  "expo": {
    "name": "Calorie Steward",
    "slug": "calorie-steward",
    "scheme": "dietsteward",
    "version": "1.2.3",
    "icon": "../android-app/branding/calorie-steward-app-icon-v1.2.1.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "locales": {
      "en": "./locales/en.json",
      "zh": "./locales/zh.json"
    },
    "plugins": [
      "./plugins/with-photo-only-ios-info",
      "./plugins/with-private-android-manifest",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calorie Steward to photograph meals and send them to your configured AI service for nutrition analysis.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Calorie Steward to use Face ID to protect API credentials."
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laisystems.dietsteward",
      "buildNumber": "7",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.laisystems.dietsteward",
      "versionCode": 7,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "../android-app/branding/calorie-steward-app-icon-v1.2.1.png",
        "backgroundColor": "#062E6F"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "permissions": [
        "CAMERA"
      ]
    },
    "extra": {
      "nutritionStandardVersion": "WHO-FAO-adult-2026-v1",
      "dietScoreVersion": "DietScore-v1.1",
      "enterpriseClientPolicy": "diet-enterprise-client.v1",
      "dataTransferConsent": "diet-data-transfer.v2",
      "officialDeveloper": "LAI ZEYU 来泽宇"
    }
  }
}
