# Raw device evidence can contain machine paths or device identifiers.
# Publish a reviewed summary instead of committing unreviewed runtime output.
release/evidence/
test-harness/results/*.json
test-harness/images/

# Local/internal release metadata. APKs belong in GitHub Release assets, not
# Git history. Public release notes are explicitly retained below.
release/*-internal.json
release/*.json
release/*-third-party-licenses.txt
release/*-android-runtime-dependencies.txt
release/*-android-third-party-licenses.txt
release/*.apk.sha256
release/*BUILD_REPORT*.md
release/*SHA256SUMS*
release/SHA256SUMS
!release/GITHUB_RELEASE_v1.2.0.md

# The browser design prototype depends on device-frame and keyboard assets whose
# public redistribution provenance has not yet been verified. It is intentionally
# outside the first public source release; mobile-app/ is the shipping product.
design-prototype/

# Superseded prototype icon with unverified provenance. The public release uses
# android-app/branding/diet-steward-app-icon-v1.2.png instead.
android-app/branding/clinical-clarity-app-icon.png
mobile-app/ios/app/Images.xcassets/AppIcon.appiconset/App-Icon-1024x1024@1x.png
